pipeline {
  agent any

  stages {
    stage('Secret text') {
      steps {
        withCredentials([string(credentialsId: 'demo-api-token', variable: 'DEMO_API_TOKEN')]) {
          sh '''
            set -euo pipefail
            echo "token_length=${#DEMO_API_TOKEN}"
            # ห้าม echo ค่า secret
          '''
        }
      }
    }

    stage('Username/password binding') {
      steps {
        withCredentials([usernamePassword(
          credentialsId: 'dockerhub-creds',
          usernameVariable: 'REGISTRY_USR',
          passwordVariable: 'REGISTRY_PSW'
        )]) {
          sh '''
            set -euo pipefail
            echo "registry_user=${REGISTRY_USR}"
            echo "password_length=${#REGISTRY_PSW}"
          '''
        }
      }
    }
  }

  post {
    always {
      echo 'Credentials demo finished'
    }
  }
}
