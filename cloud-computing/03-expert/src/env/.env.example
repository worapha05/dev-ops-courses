# Expert env template — ไม่ใส่ credentials จริง

# Project
PROJECT_NAME=ccp-xprt
ENVIRONMENT=prod

# AWS
AWS_PROFILE=bootcamp
AWS_REGION_PRIMARY=ap-southeast-1
AWS_REGION_SECONDARY=ap-northeast-1
