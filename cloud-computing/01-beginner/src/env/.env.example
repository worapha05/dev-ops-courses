# คัดลอกเป็น .env แล้วแก้ค่า — ห้าม commit ไฟล์ .env
# cp .env.example .env

# ─── ทั่วไป ───
PROJECT_NAME=ccp-bootcamp
ENVIRONMENT=dev
OWNER_EMAIL=you@example.com

# ─── AWS ───
AWS_PROFILE=bootcamp
AWS_REGION=ap-southeast-1
AWS_ACCOUNT_ID=123456789012

# อย่าใส่ Access Key ถาวรที่นี่ถ้าใช้ SSO ได้
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ─── GCP ───
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-southeast1
GCP_ZONE=asia-southeast1-a

# path ไปยัง SA key เฉพาะเมื่อจำเป็น (แนะนำ Workload Identity แทน)
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/sa.json

# ─── Naming ───
BUCKET_SUFFIX=change-me-to-unique
