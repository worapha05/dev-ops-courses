# คัดลอกเป็น .env — ห้าม commit
# ใช้ชื่อ secret ใน manager ไม่ใส่ค่ารหัสผ่านจริงในไฟล์นี้

PROJECT_NAME=ccp-mid
ENVIRONMENT=staging

AWS_PROFILE=bootcamp
AWS_REGION=ap-southeast-1

GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-southeast1

# อ้างอิงชื่อ secret (ค่าจริงอยู่ใน Secrets Manager / Secret Manager)
AWS_SECRET_NAME=ccp-mid/db/credentials
GCP_SECRET_ID=ccp-mid-db-credentials

# ค่า non-secret สำหรับแอป
APP_PORT=8080
APP_IMAGE=ghcr.io/example/ccp-mid-api:latest

# VPC CIDRs (ต้องไม่ทับกันถ้าเชื่อม VPN)
VPC_CIDR=10.20.0.0/16
